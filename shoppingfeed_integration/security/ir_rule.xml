<?xml version="1.0" encoding="utf-8" ?>
<odoo noupdate="1">
    <record id="shoppingfeed_store_company_rule" model="ir.rule">
        <field name="name">Shoppingfeed Store: company restriction</field>
        <field name="model_id" ref="model_shoppingfeed_store" />
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        <field name="global" eval="True" />
    </record>
    <record id="shoppingfeed_channel_company_rule" model="ir.rule">
        <field name="name">Shoppingfeed Channel: company restriction</field>
        <field name="model_id" ref="model_shoppingfeed_channel" />
