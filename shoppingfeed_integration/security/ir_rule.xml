        <field name="model_id" ref="model_shoppingfeed_ticket" />
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        <field name="global" eval="True" />
    </record>
    <record id="shoppingfeed_log_company_rule" model="ir.rule">
        <field name="name">Shoppingfeed Log: company restriction</field>
        <field name="model_id" ref="model_shoppingfeed_log" />
