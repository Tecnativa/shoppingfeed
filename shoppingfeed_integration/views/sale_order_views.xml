<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="view_order_form_shoppingfeed" model="ir.ui.view">
        <field name="name">sale.order.form.shoppingfeed</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form" />
        <field name="arch" type="xml">
            <xpath expr="//notebook" position="inside">
                <page string="Shoppingfeed" invisible="not shoppingfeed_order_ref">
                    <group>
                        <field name="shoppingfeed_order_ref" />
                        <field name="shoppingfeed_reference" />
                        <field name="shoppingfeed_store_id" />
                        <field name="shoppingfeed_channel_id" />
                        <field name="shoppingfeed_status" />
                    </group>
                    <group string="Raw Data">
                        <field name="shoppingfeed_raw_data" widget="ace" />
                    </group>
                </page>
            </xpath>
        </field>
    </record>
    <record id="view_order_tree_shoppingfeed" model="ir.ui.view">
        <field name="name">sale.order.tree.shoppingfeed</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_tree" />
        <field name="arch" type="xml">
            <field name="user_id" position="attributes">
                <attribute name="optional">hide</attribute>
            </field>
            <field name="activity_ids" position="attributes">
                <attribute name="optional">hide</attribute>
            </field>
            <field name="website_id" position="attributes">
                <attribute name="optional">hide</attribute>
            </field>
            <field name="user_id" position="after">
                <field name="shoppingfeed_store_id" widget="badge" optional="show" />
                <field name="shoppingfeed_channel_id" widget="badge" optional="show" />
                <field name="shoppingfeed_reference" optional="show" />
            </field>
        </field>
    </record>
    <record id="action_shoppingfeed_marketplace_orders" model="ir.actions.act_window">
        <field name="name">Marketplace Orders</field>
        <field name="res_model">sale.order</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('shoppingfeed_order_ref', '!=', False)]</field>
        <field name="context">{}</field>
    </record>
    <record id="view_sale_order_filter_shoppingfeed" model="ir.ui.view">
        <field name="name">sale.order.search.shoppingfeed</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_sales_order_filter" />
        <field name="arch" type="xml">
            <field name="user_id" position="after">
                <field name="shoppingfeed_reference" string="Pedido de market" />
                <separator />
                <filter
                    name="shoppingfeed"
                    string="Shoppingfeed Orders"
                    domain="[('shoppingfeed_order_ref', '!=', False)]"
                    help="Show only orders imported from Shoppingfeed."
                />
            </field>
        </field>
    </record>
</odoo>
