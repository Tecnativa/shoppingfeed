<?xml version="1.0" encoding="utf-8" ?>
<odoo noupdate="1">
    <record id="ir_cron_shoppingfeed_import_orders" model="ir.cron">
        <field name="name">Shoppingfeed: Import Orders</field>
        <field name="model_id" ref="sale.model_sale_order" />
        <field name="state">code</field>
        <field name="code">model.action_import_from_shoppingfeed()</field>
        <field name="interval_number">15</field>
        <field name="interval_type">minutes</field>
        <field name="active">False</field>
    </record>
    <record id="ir_cron_fetch_all_shoppingfeed_tickets" model="ir.cron">
        <field name="name">Shoppingfeed: Import Tickets</field>
        <field name="model_id" ref="model_shoppingfeed_ticket" />
        <field name="state">code</field>
        <field name="code">model.cron_fetch_all_tickets()</field>
        <field name="interval_number">60</field>
        <field name="interval_type">minutes</field>
        <field name="active">True</field>
    </record>
</odoo>
